---
/* Home: about. Terminal window: prose as output, skills as a config file,
   education as a log entry. All copy drawn from the résumé. */
const toolkit = [
	{
		label: 'frontend',
		items: 'react, next.js, typescript, tanstack (query, form, router, table), react-hook-form, zod, zustand, rtk, tailwind css, shadcn/ui, base ui, ant design, storybook, figma, seo & accessibility',
	},
	{
		label: 'backend',
		items: 'trpc, hono, elysia, node.js, bun, postgresql, sqlite, drizzle orm, elasticsearch, ai sdk',
	},
	{
		label: 'build',
		items: 'vite, webpack, turborepo, vitest, playwright',
	},
	{
		label: 'ops',
		items: 'azure devops, gitlab, grafana stack (loki, tempo, prometheus), sentry',
	},
];

const education = {
	degree: "Bachelor's Degree in Software Engineering",
	school: 'Bojnord University',
	period: 'Sep 2010 to May 2015',
};
---

<section class="sh-section" id="about">
	<div class="shell">
		<div class="sh-win" data-reveal>
			<header class="sh-win__bar">
				<span class="sh-win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
				<h2 class="sh-win__name">man about</h2>
				<span class="sh-win__meta">3 sections</span>
			</header>

			<div class="sh-win__body sh-about">
				<div class="sh-prose">
					<p class="sh-para">
						<span class="sh-para__n">01</span>I'm Ali Fahim, a software engineer focused on the
						frontend: React, Next.js and TypeScript, mostly. I care about the part people
						actually touch: how fast the first screen lands, whether search finds the thing, and
						what happens on the second click.
					</p>
					<p class="sh-para">
						<span class="sh-para__n">02</span>Day to day I'm at Yadak, working on search, an AI
						chat assistant, and the type-safe API layer behind a large car marketplace. React and
						Next.js on the front, tRPC and Postgres behind it, Elasticsearch doing the heavy
						lifting. I also set up the design system foundation the UI is built on.
					</p>
					<p class="sh-para">
						<span class="sh-para__n">03</span>I like the unglamorous half: migrating a legacy
						codebase without breaking it, wiring CI/CD so nobody deploys on a Friday by hand, and
						turning a design file into components the rest of the team can actually use.
					</p>
				</div>

				<aside class="sh-aside">
					<section class="sh-pane">
						<h3 class="sh-pane__title">toolkit.conf</h3>
						<dl class="sh-kv sh-kv--flush">
							{
								toolkit.map((row) => (
									<div class="sh-kv__row">
										<dt>{row.label}</dt>
										<dd>{row.items}</dd>
									</div>
								))
							}
						</dl>
					</section>

					<section class="sh-pane">
						<h3 class="sh-pane__title">education.log</h3>
						<div class="sh-edu">
							<p class="sh-edu__degree">{education.degree}</p>
							<p class="sh-edu__meta">
								{education.school} <span class="sh-sep">·</span> {education.period}
							</p>
						</div>
					</section>
				</aside>
			</div>
		</div>
	</div>
</section>

<style>
	.sh-about {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(1.5rem, 1rem + 2vw, 3rem);
		align-items: start;
	}

	.sh-prose {
		color: var(--ink-soft);
		max-width: 44rem;
	}

	.sh-para {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 0.75rem;
	}

	.sh-para + .sh-para {
		margin-top: 1.15rem;
	}

	.sh-para__n {
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		padding-top: 0.2rem;
	}

	.sh-aside {
		display: grid;
		gap: 1.25rem;
	}

	.sh-pane {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding-bottom: 1rem;
	}

	.sh-pane__title {
		padding: 0.45rem 0.9rem;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--accent) 6%, transparent);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--accent-deep);
	}

	.sh-pane .sh-kv--flush {
		border: 0;
		background: transparent;
		padding-inline: 0.9rem;
	}

	.sh-pane .sh-kv__row {
		grid-template-columns: 5rem minmax(0, 1fr);
		gap: 0.75rem;
	}

	.sh-pane dd {
		text-align: left;
		line-height: 1.7;
	}

	.sh-edu {
		padding: 0.9rem 0.9rem 0;
	}

	.sh-edu__degree {
		color: var(--ink);
		font-weight: 700;
	}

	.sh-edu__meta {
		margin-top: 0.3rem;
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-muted);
	}

	@media (max-width: 64rem) {
		.sh-about {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
