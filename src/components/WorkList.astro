---
/* Home: concise career highlights linking to the full role details below. */
import { work } from '../data/experience';
---

<section class="sh-section" id="work">
	<div class="shell">
		<div class="sh-win" data-reveal>
			<header class="sh-win__bar">
				<span class="sh-win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
				<h2 class="sh-win__name">~/portfolio/career-highlights</h2>
				<span class="sh-win__meta">{work.length} roles</span>
			</header>

			<div class="sh-win__body">
				<ul class="sh-list">
					{
						work.map((item) => (
							<li>
								<a class="sh-row" href={`#role-${item.id}`}>
									<span class="sh-row__idx">{item.index}</span>

									<span class="sh-row__name">
										<span class="sh-row__title">{item.company}</span>
										<span class="sh-row__tag">
											{item.role} · {item.period}
										</span>
									</span>

									<span class="sh-row__description">{item.description}</span>
								</a>
							</li>
						))
					}
				</ul>

				<p class="sh-hint">
					<span class="sh-sep">$</span> full history, bullet by bullet, on <a
						class="link"
						href="https://www.linkedin.com/in/ali-fahim">linkedin ↗</a
					>
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.sh-list {
		border-top: 1px solid var(--line);
	}

	.sh-row {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, 1.4fr);
		gap: 1rem 1.5rem;
		align-items: center;
		padding: 0.75rem 0.75rem;
		margin-inline: -0.75rem;
		border-bottom: 1px solid var(--line);
		color: inherit;
		transition: background-color var(--duration) var(--ease-out);
	}

	.sh-row::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--accent);
		transform: scaleY(0);
		transform-origin: center;
		transition: transform var(--duration) var(--ease-out);
	}

	.sh-row__idx {
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
	}

	.sh-row__idx::before {
		content: '>';
		display: inline-block;
		margin-right: 0.35rem;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity var(--duration) var(--ease-out),
			transform var(--duration) var(--ease-out);
	}

	.sh-row:focus-visible {
		background: var(--accent-wash);
	}

	.sh-row:focus-visible::before {
		transform: scaleY(1);
	}

	.sh-row:focus-visible .sh-row__idx::before {
		opacity: 1;
		transform: translateX(0);
	}

	.sh-row__name {
		display: block;
		min-width: 0;
	}

	.sh-row__title {
		display: block;
		font-weight: 700;
		font-size: var(--step-0);
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.sh-row__tag {
		display: block;
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-muted);
		line-height: 1.5;
	}

	.sh-row__description {
		grid-column: 3;
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.sh-hint {
		margin-top: 0.9rem;
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-muted);
	}

	.sh-hint .link {
		color: var(--ink-soft);
	}

	@media (hover: hover) and (pointer: fine) {
		.sh-row:hover {
			background: var(--accent-wash);
		}

		.sh-row:hover::before {
			transform: scaleY(1);
		}

		.sh-row:hover .sh-row__idx::before {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@media (max-width: 64rem) {
		.sh-row {
			grid-template-columns: 2.5rem minmax(0, 1fr);
		}

		.sh-row__description {
			grid-column: 2;
		}
	}

	@media (max-width: 44rem) {
		.sh-row {
			grid-template-columns: 2.5rem minmax(0, 1fr);
			align-items: start;
			row-gap: 0.35rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sh-row::before,
		.sh-row__idx::before {
			transition: none;
		}
	}
</style>
